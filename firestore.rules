rules_version = '2';
// Paste these into Firebase console > Firestore Database > Rules, then click Publish.
// A signed-in farmer can read and write only their own saved checks.
// Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/checks/{checkId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
